__pycache__/
*.py[cod]
node_modules/

# Build output. `python src/build.py` regenerates all of it from `data/`, and two
# of the files make it a bad thing to carry in history: index.html is 8.4 MB
# rewritten on every build, and icons.png is an atlas cut from the game's own art
# -- the same art the source PNGs under data/icons/ carry. Those are tracked
# because the build cannot run without them; this is regenerated.
out/

# wrangler's local cache and dev state, written on any `wrangler deploy`.
.wrangler/

# Everything under test/ is scratch: the probe scripts that cracked the .DAT
# format, the sample files they ran on, the card mockups, and the third-party
# material this repo should not republish -- TIDBI's installer and UI bitmaps,
# the alfgeir scrape, a scrape of grimtools.com. None of it is read by the build
# and none of it is needed to render the site, so it stays on disk and out of git.
#
# One file used to live here and no longer does. The regression suite is
# verify/check_page.js: it is the check the build has to pass, not scratch, so it
# is tracked beside src/ and web/ where a fresh clone can still run it.
test/
